# isWebMCP does not require application secrets for local development.
# Add deployment-specific values only through the hosting provider's secret store.

# Stable canonical origin for metadata, RSS, robots.txt, and sitemap.xml.
SITE_URL=https://iswebmcp.com

# Optional durable URL-attempt analytics. Vercel's Neon integration injects
# this value automatically; never commit a real connection string.
DATABASE_URL=
