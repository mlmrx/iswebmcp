{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "bun.lockb",
    "test-results/**",
    "playwright-report/**",
    "blob-report/**",
    "dist/**",
    ".next/**",
    ".vinext/**",
    ".wrangler/**",
    "*.tsbuildinfo"
  ]
}
